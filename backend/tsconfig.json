{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false
  },

  "include": [
    "src/**/*.ts",
    "prisma7.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}